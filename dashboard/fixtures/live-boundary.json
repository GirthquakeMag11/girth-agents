{
  "version": "5",
  "agents": [
    "agents/builder.md",
    "agents/reviewer.md"
  ],
  "graph": {
    "maxSteps": 20,
    "workflows": [
      {
        "id": "A",
        "entry": "a1",
        "exit": "a1",
        "nodes": [
          "a1"
        ],
        "connections": [
          "B"
        ],
        "strict": false
      },
      {
        "id": "B",
        "entry": "b1",
        "exit": "b1",
