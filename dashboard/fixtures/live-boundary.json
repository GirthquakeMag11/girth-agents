{
  "version": "4",
  "agents": [
    "agents/builder.md",
    "agents/reviewer.md"
  ],
  "graph": {
    "outputRoot": "work",
    "maxSteps": 20,
    "workflows": [
      {
        "id": "A",
        "entry": "a1",
        "exit": "a1",
        "nodes": [
          "a1"
        ],
        "connections": [
          "B"
        ],
        "strict": false
      },
      {
        "id": "B",
        "entry": "b1",
        "exit": "b1",
        "nodes": [
          "b1"
        ],
        "connections": [],
        "strict": false
      }
    ],
    "nodes": [
      {
        "id": "a1",
        "agent": "builder",
        "objective": "Write work/a1.md containing exactly: main. Then call the `next` tool with a message.",
        "output": "a1.md",
        "maxVisits": 2,
        "handoff": {
          "mode": "unconditional",
          "to": "b1",
          "description": "The main node is ready; move into connected B."
        }
      },
      {
        "id": "b1",
        "agent": "builder",
        "objective": "Write work/b1.md containing exactly: connected. Then call the `next` tool with a message.",
        "output": "b1.md",
        "maxVisits": 2,
        "handoff": {
          "mode": "unconditional",
          "to": "o",
          "description": "Leave the connected workflow for the escape proof."
        }
      },
      {
        "id": "o",
        "agent": "builder",
        "objective": "Write work/o.md containing exactly: escaped. Then stop.",
        "output": "o.md",
        "maxVisits": 2,
        "handoff": {
          "mode": "terminal"
        }
      }
    ]
  }
}
