        "maxVisits": 2,
        "handoff": {
          "mode": "unconditional",
          "to": "b1",
          "description": "The main node is ready; move into connected B."
        }
      },
      {
        "id": "b1",
        "agent": "builder",
        "objective": "Complete the connected node work. Then call the `next` tool with a message.",
        "maxVisits": 2,
        "handoff": {
          "mode": "unconditional",
          "to": "o",
          "description": "Leave the connected workflow for the escape proof."
        }
      },
      {
        "id": "o",
        "agent": "builder",
        "objective": "Complete the escape node work. Then stop.",
        "maxVisits": 2,
        "handoff": {
          "mode": "terminal"
        }
      }
    ]
  }
