{
  "version": "6",
  "agents": [
    {
      "id": "builder",
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "mounts": ["graph"],
      "tools": ["read", "edit", "shell"],
      "prompt": "Execute the node objective, then call the generated handoff tool exactly once with a message."
    },
    {
      "id": "reviewer",
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "mounts": ["graph"],
      "tools": ["read", "edit", "shell"],
      "prompt": "Judge the work, then call the declared handoff label."
    }
  ],
  "graph": {
    "maxSteps": 20,
    "workflows": [
      {
        "id": "A",
        "entry": "a1",
        "exit": "a1",
        "nodes": ["a1"],
        "connections": ["B"],
        "strict": false
      },
      {
        "id": "B",
        "entry": "b1",
        "exit": "b1",
        "nodes": ["b1"],
        "connections": [],
        "strict": false
      }
    ],
    "nodes": [
      {
        "id": "a1",
        "agent": "builder",
        "objective": "Complete the main node work. Then call the `next` tool with a message.",
        "maxVisits": 2,
        "handoff": {
          "mode": "unconditional",
          "to": "b1",
          "description": "The main node is ready; move into connected B."
        }
      },
      {
        "id": "b1",
        "agent": "builder",
        "objective": "Complete the connected node work. Then call the `next` tool with a message.",
        "maxVisits": 2,
        "handoff": {
          "mode": "unconditional",
          "to": "o",
          "description": "Leave the connected workflow for the escape proof."
        }
      },
      {
        "id": "o",
        "agent": "builder",
        "objective": "Complete the escape node work. Then stop.",
        "maxVisits": 2,
        "handoff": {
          "mode": "terminal"
        }
      }
    ]
  }
}