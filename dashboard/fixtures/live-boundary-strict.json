{
  "version": "6",
  "agents": [
    {
      "id": "builder",
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "mounts": ["graph"],
      "tools": ["read", "edit", "shell"],
      "prompt": "Execute the node objective, then call the generated handoff tool exactly once with a message."
    }
  ],
  "graph": {
    "maxSteps": 10,
    "workflows": [
      {
        "id": "A",
        "entry": "a1",
        "exit": "a1",
        "nodes": ["a1"],
        "connections": ["B"],
        "strict": true
      },
      {
        "id": "B",
        "entry": "b1",
        "exit": "b1",
        "nodes": ["b1"],
        "connections": [],
        "strict": false
      }
    ],
    "nodes": [
      {
        "id": "a1",
        "agent": "builder",
        "objective": "Complete the strict main node work. Then call the `handoff` tool with a message.",
        "maxVisits": 2,
        "handoff": {
          "mode": "unconditional",
          "to": "b1",
          "description": "Move into connected B."
        }
      },
      {
        "id": "b1",
        "agent": "builder",
        "objective": "Complete the strict connected node work. Then call the `handoff` tool with a message.",
        "maxVisits": 2,
        "handoff": {
          "mode": "unconditional",
          "to": "o",
          "description": "Attempt to leave the strict boundary."
        }
      },
      {
        "id": "o",
        "agent": "builder",
        "objective": "Complete the strict escape node work.",
        "maxVisits": 2,
        "handoff": {
          "mode": "terminal"
        }
      }
    ]
  }
}